---
import { t } from '../../i18n';
import type { Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = lang === 'es' ? '' : `/${lang}`;
---
<section class="lp-section lp-access" aria-label={t(lang, 'home.access.aria')}>
  <div class="container lp-access-grid">

    <article class="lp-access-card" data-reveal>
      <span class="lp-access-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M4 7h6M14 7h6M4 12h12M20 12h0M4 17h4M12 17h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <circle cx="12" cy="7" r="2" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="18" cy="12" r="2" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="10" cy="17" r="2" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </span>
      <h2>{t(lang, 'home.access.card1Title')}</h2>
      <p>{t(lang, 'home.access.card1Text')}</p>
      <a href={`${p}/configurador.html`} class="lp-ghost-btn">
        {t(lang, 'home.access.card1Cta')}
        <span aria-hidden="true"><svg viewBox="0 0 16 16" fill="none"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      </a>
    </article>

    <article class="lp-access-card" data-reveal>
      <span class="lp-access-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M5 20V11M12 20V4M19 20v-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
        </svg>
      </span>
      <h2>{t(lang, 'home.access.card2Title')}</h2>
      <p>{t(lang, 'home.access.card2Text')}</p>
      <a href="#presupuestos" class="lp-ghost-btn">
        {t(lang, 'home.access.card2Cta')}
        <span aria-hidden="true"><svg viewBox="0 0 16 16" fill="none"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      </a>
    </article>

    <article class="lp-access-card" data-reveal>
      <span class="lp-access-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M12 6.5C10.4 5.2 8.3 4.6 5 4.6v13c3.3 0 5.4.6 7 1.9 1.6-1.3 3.7-1.9 7-1.9v-13c-3.3 0-5.4.6-7 1.9Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          <path d="M12 6.5v12.9" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </span>
      <h2>{t(lang, 'home.access.card3Title')}</h2>
      <p>{t(lang, 'home.access.card3Text')}</p>
      <a href={`${p}/guias.html`} class="lp-ghost-btn">
        {t(lang, 'home.access.card3Cta')}
        <span aria-hidden="true"><svg viewBox="0 0 16 16" fill="none"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      </a>
    </article>

    <article class="lp-access-card" data-reveal>
      <span class="lp-access-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <rect x="3.2" y="5.4" width="17.6" height="13.2" rx="2.2" stroke="currentColor" stroke-width="1.5"/>
          <path d="m4.4 7 7.6 5.6L19.6 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <h2>{t(lang, 'home.access.card4Title')}</h2>
      <p>{t(lang, 'home.access.card4Text')}</p>
      <a href={`${p}/contacto.html`} class="lp-ghost-btn">
        {t(lang, 'home.access.card4Cta')}
        <span aria-hidden="true"><svg viewBox="0 0 16 16" fill="none"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      </a>
    </article>

    <article class="lp-access-card" data-reveal>
      <span class="lp-access-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M12 3.2 19.2 6v6.1c0 4.2-2.9 7.2-7.2 8.7-4.3-1.5-7.2-4.5-7.2-8.7V6L12 3.2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          <path d="M9.4 11.8V10a2.6 2.6 0 0 1 5.2 0v1.8" stroke="currentColor" stroke-width="1.4"/>
          <rect x="8.6" y="11.8" width="6.8" height="5" rx="1.4" stroke="currentColor" stroke-width="1.4"/>
        </svg>
      </span>
      <h2>{t(lang, 'home.access.card5Title')}</h2>
      <p>{t(lang, 'home.access.card5Text')}</p>
      <a href={`${p}/privacidad.html`} class="lp-ghost-btn">
        {t(lang, 'home.access.card5Cta')}
        <span aria-hidden="true"><svg viewBox="0 0 16 16" fill="none"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      </a>
    </article>

  </div>
</section>
