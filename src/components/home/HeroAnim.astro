<script>
  import anime from 'animejs';

  // Marca de que el motor de entrada del hero (animejs) se cargó.
  document.documentElement.classList.add('hero-anime-ready');

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!prefersReduced) {
    const copy = document.querySelector('.lp-hero-copy');
    const layers = document.querySelectorAll('.lp-hero-art .lp-layer');

    if (copy) {
      anime({
        targets: copy,
        opacity: [0, 1],
        translateY: [16, 0],
        easing: 'easeOutQuad',
        duration: 600,
      });
    }
    if (layers.length) {
      anime({
        targets: layers,
        opacity: [0, 1],
        translateY: [12, 0],
        delay: anime.stagger(80, { start: 150 }),
        easing: 'easeOutQuad',
        duration: 500,
      });
    }
  }
</script>
